[project]
name = "kuiskaus"
version = "0.1.0"
requires-python = ">=3.11"
dependencies = [
    "pyobjc-core",
    "pyobjc-framework-Cocoa",
    "pyobjc-framework-Quartz",
    "pyobjc-framework-ApplicationServices",
    "pyaudio",
    "numpy",
    "mlx-whisper",
    "mlx-voxtral",
    "parakeet-mlx",
    "numba>=0.57.0",
    "rumps",
    "python-dotenv",
]

[dependency-groups]
dev = ["ty", "pytest", "pytest-cov", "ruff"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ty.environment]
python-version = "3.11"
extra-paths = ["./stubs"]

# pyobjc framework modules (AppKit, Quartz, Foundation, ApplicationServices)
# expose their ObjC symbols via a runtime `__getattr__` that static checkers
# cannot see. The stubs/ directory makes those modules dynamically
# resolvable for ty; the override below covers `from X import name` member
# lookups, which module-level `__getattr__` stubs alone do not silence.
[tool.ty.rules]
unresolved-attribute = "ignore"

[[tool.ty.overrides]]
include = ["kuiskaus/hotkey_listener_cgevent.py"]

[tool.ty.overrides.analysis]
allowed-unresolved-imports = ["ApplicationServices"]
